{
  "name": "has-toggle",
  "version": "5.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "analyze": "turbo analyze",
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "bump-deps": "bunx --bun npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx --bun shadcn@latest add --all --overwrite -c packages/design-system",
    "check": "bunx --bun ultracite check",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev",
    "fix": "bunx --bun ultracite fix",
    "test": "turbo test",
    "translate": "turbo translate",
    "update-docs": "npx @next/codemod@canary agents-md --output CLAUDE.md"
  },
  "overrides": {
    "@radix-ui/react-slot": "1.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "parse5": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.9",
    "@types/node": "^26.0.0",
    "bun-types": "latest",
    "turbo": "2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
